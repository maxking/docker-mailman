# syntax = docker/dockerfile:1.3
FROM alpine:3.23

# Pinned commits of the unreleased Django 5.2 compatible code. Override with
# --build-arg to build other revisions (branch names and tags work too).
ARG POSTORIUS_REF=ac7a353849a2ea80583ec2ace477165cf2cb7671
ARG HYPERKITTY_REF=3e2447fe144cc269755cb96f13817053c5449775
ARG DJ_MM3_REF=7f8fc065abfdaddd9ac14d9835c6e486cf62b292
ARG CLIENT_REF=6eb7f287c61f73ae7bd674a9187e1cca0e356bb5

# Install packages and dependencies for postorius and hyperkitty Add user for
# executing apps, change ownership for uwsgi+django files and set execution
# rights for management script
RUN --mount=type=cache,target=/root/.cache \
    set -ex \
    && apk add --no-cache --virtual .build-deps gcc libc-dev linux-headers git \
        postgresql-dev mariadb-dev mariadb-connector-c python3-dev libffi-dev openldap-dev cargo rust \
        g++ make xapian-core-dev zlib-dev util-linux-dev \
    && apk add --no-cache --virtual .mailman-rundeps bash sassc pcre-dev tzdata libldap \
        python3 py3-pip postgresql-client mysql-client py3-mysqlclient \
        curl mailcap xapian-core libffi gettext py-cryptography \
    && python3 -m pip install --break-system-packages -U pip setuptools wheel \
    && python3 -m pip install --break-system-packages -U \
        git+https://gitlab.com/mailman/mailmanclient@${CLIENT_REF} \
        git+https://gitlab.com/mailman/postorius@${POSTORIUS_REF} \
        git+https://gitlab.com/mailman/hyperkitty@${HYPERKITTY_REF} \
        git+https://gitlab.com/mailman/django-mailman3@${DJ_MM3_REF} \
        whoosh \
        uwsgi \
        psycopg2 \
        dj-database-url \
        mysqlclient \
        xapian-bindings \
        xapian-haystack \
        django-auth-ldap \
        pymemcache \
	    tzdata \
        diskcache \
        django-utils-six \
		'django-allauth[socialaccount,openid]' \
    && apk del .build-deps \
    && addgroup -S mailman \
    && adduser -S -G mailman mailman

# Add needed files for uwsgi server + settings for django
COPY mailman-web /opt/mailman-web
# Add startup script to container
COPY docker-entrypoint.sh /usr/local/bin/

RUN chown -R mailman /opt/mailman-web/ \
	&& chmod u+x /opt/mailman-web/manage.py

WORKDIR /opt/mailman-web

# Expose port 8000 for http and port 8080 for uwsgi
# (see web/mailman-web/uwsgi.ini#L2-L4)
EXPOSE 8000 8080

# Use stop signal for uwsgi server
STOPSIGNAL SIGINT

ENTRYPOINT ["docker-entrypoint.sh"]

CMD ["uwsgi", "--ini", "/opt/mailman-web/uwsgi.ini"]
